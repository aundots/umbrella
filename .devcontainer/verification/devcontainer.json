{
  "name": "umbrella verification (2-core)",
  "hostRequirements": {
    "cpus": 2
  },
  "remoteUser": "node",
  "postCreateCommand": "echo 'Verification environment ready; run approved setup manually.'",
  "postStartCommand": "echo 'No automatic backup or update.'",
  "forwardPorts": [
    3000,
    5173,
    8080
  ],
  "portsAttributes": {
    "3000": {
      "label": "Web app",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Vite",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "files.autoSave": "afterDelay",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/node/.local/bin"
  },
  "secrets": {
    "HYBRID_KEY_UMBRELLA": {
      "description": "Project-specific backup key"
    },
    "HYBRID_DRIVE_CONFIG": {
      "description": "Encrypted rclone configuration"
    },
    "HYBRID_DRIVE_PASSWORD": {
      "description": "rclone configuration password"
    }
  },
  "build": {
    "dockerfile": "Dockerfile"
  }
}
