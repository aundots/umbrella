PORT=3001

# 공공데이터포털(data.go.kr) 기상청 API — Encoding(인코딩) 키 사용
# 동일 키로 아래 API 각각 활용신청 필요 (마이페이지 → 활용신청 현황)
# 1) 초단기실황·초단기예보 (VilageFcstInfoService_2.0) — relay 기본
# 2) 동네예보 (getVilageFcst) — POP·기온·습도 등 상세 예보
# 3) 레이더영상 조회 (RadarImgInfoService/getCmpImg) — 레이더 화면
# 4) 레이더자료 경량화 (WthrRadarInfoService/getCompCappiQcdAll) — HSR 500m 수치
DATA_GO_KR_SERVICE_KEY=your_encoding_service_key

# MAPLE nowcasting (기상청 API허브 별도 authKey — apihub.kma.go.kr)
# 레이더 → 초단기 강수예측(QPF) API 활용신청 후 발급
# KMA_APIHUB_AUTH_KEY=your_apihub_auth_key

# mTLS (앱인토스 콘솔에서 발급) — 로컬은 파일 경로, Vercel은 PEM 본문 env 권장
# MTLS_CERT_PATH=./mtls/weather_public.crt
# MTLS_KEY_PATH=./mtls/weather_private.key
# MTLS_CERT_PEM=-----BEGIN CERTIFICATE-----\n...
# MTLS_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...
# Vercel에서 줄바꿈이 깨지면 base64 한 줄로 넣기 (권장):
# MTLS_CERT_PEM_B64=base64(weather_public.crt 전체)
# MTLS_KEY_PEM_B64=base64(weather_private.key 전체)

# TOSS_API_BASE_URL=https://apps-in-toss-api.toss.im
# TOSS_PUSH_TEMPLATE_CODE=umbrella-_rain_alert (발송 코드 — send-message)
# TOSS_AGREEMENT_TEMPLATE_CODE=umbrella-_rain_alert (미설정 시 발송 코드와 동일 — 토스 공식 답변)
# TOSS_PUSH_TEMPLATE_CODE_CLEAR=umbrella-_rain_clear (내용: {{ msg }} 비 그쳤어요.)
# TOSS_PUSH_TEMPLATE_CODE_END_SOON=umbrella_rain_end_soon (내용: {{ msg }} 비 곧 그쳐요.)
# TOSS_PUSH_TEMPLATE_CODE_CANCEL=umbrella_rain_cancel (내용: {{ msg }} 비 예보 취소됐어요.)
#
# 기능성 캠페인은 수정 불가 → 토스 콘솔에서 새로 생성 후 위 코드를 Vercel에 갱신
# 재생성 전 서버 발송 중단: node scripts/pause-notify-push.mjs
# 검수 승인 후 재개: node scripts/resume-notify-push.mjs
# NOTIFY_PUSH_ENABLED=false (pause 스크립트가 자동 설정)
# TOSS_DEPLOYMENT_ID=ait_빌드_deploymentId (테스트 푸시용 — npm run build 시 scripts/sync-vercel-deployment-id.mjs 가 Vercel에 자동 반영)

# DB 영구 저장 (Upstash Redis 무료 — Vercel Hobby OK, Pro 불필요)
# https://console.upstash.com → Redis 생성 → REST API
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxx...
# Vercel Storage KV 연동 시 자동 env도 동일하게 동작:
# KV_REST_API_URL / KV_REST_API_TOKEN

# Cron 인증 — QStash/GitHub Actions(외부 스케줄러)가 Bearer로 전달
# Vercel env + 스케줄러 둘 다 동일 값 권장
# CRON_SECRET=random_long_secret

# QStash(Upstash) 알림 스캔 스케줄러 — 비 시작/그침 전이를 놓치지 않으려면 분 단위 호출 필요
# GitHub Actions 무료 cron은 30분~2시간씩 지연되어 부적합 → QStash 권장
# https://console.upstash.com/qstash 에서 QSTASH_TOKEN 발급
# 셋업: npm run qstash:setup --prefix server  (한 번만 실행 → 스케줄 생성)
# 목록: npm run qstash:list --prefix server
# QSTASH_TOKEN=eyJ...
# NOTIFY_CRON_URL=https://umbrella-three-iota.vercel.app/cron/notify  (선택, 기본값 동일)
# QSTASH_CRON=*/5 * * * *  (선택, 기본 5분마다 — 무료 한도 500/일 이내)
